{
  "info": {
    "name": "SPC — SISEPP API v1",
    "description": "SISEPP — proyecto de portafolio con datos ficticios.\n\nFlujo: Login → Planificación → Líneas → Programas → Proyectos → Coordinadores → Actividades → Tareas → Seguimiento → Financiero → Árbol.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 — Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.environment.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coordinador@example.com\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<paste-token-from-email>\",\n  \"newPassword\": \"NuevaClave123*\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "02 — Usuarios",
      "item": [
        {
          "name": "Listar Usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users?role=&status=&search=",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "role", "value": "", "description": "DIRECTOR | COORDINADOR | ADMINISTRADOR" },
                { "key": "status", "value": "", "description": "ACTIVO | INACTIVO" },
                { "key": "search", "value": "", "description": "Busca en nombre y email" }
              ]
            }
          }
        },
        {
          "name": "Crear Usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Persona de Ejemplo\",\n  \"email\": \"persona.ejemplo@example.com\",\n  \"role\": \"COORDINADOR\"\n}"
            }
          }
        },
        {
          "name": "Actualizar Usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/users/{{user_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Persona de Ejemplo Actualizado\",\n  \"role\": \"COORDINADOR\"\n}"
            }
          }
        },
        {
          "name": "Inactivar Usuario",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/v1/users/{{user_id}}/inactivate"
          }
        },
        {
          "name": "Activar Usuario",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/v1/users/{{user_id}}/activate"
          }
        }
      ]
    },
    {
      "name": "03 — Catálogo: Líneas Estratégicas",
      "item": [
        {
          "name": "Listar Líneas Estratégicas",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/structure/strategic-lines"
          }
        },
        {
          "name": "Crear Línea Estratégica",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/strategic-lines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gestión Integral del Recurso Hídrico\",\n  \"description\": \"Línea orientada a la gestión sostenible del agua en la jurisdicción de ejemplo\"\n}"
            }
          }
        },
        {
          "name": "Actualizar Línea Estratégica",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/strategic-lines/{{strategic_line_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gestión Integral del Recurso Hídrico (Actualizada)\",\n  \"description\": \"Línea actualizada\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "04 — Catálogo: Indicadores ODS",
      "item": [
        {
          "name": "Listar Indicadores ODS",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/structure/sdg-indicators"
          }
        }
      ]
    },
    {
      "name": "05 — Programas",
      "item": [
        {
          "name": "Listar Programas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/structure/programs?strategicLineId=",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "structure", "programs"],
              "query": [
                { "key": "strategicLineId", "value": "", "description": "UUID de la línea estratégica" }
              ]
            }
          }
        },
        {
          "name": "Crear Programa",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/programs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Administración y Manejo del Sistema de Áreas Protegidas\",\n  \"strategicLineId\": \"{{strategic_line_id}}\",\n  \"code\": \"3201\",\n  \"weight\": 25.00,\n  \"description\": \"Programa para la administración del SINAP regional\"\n}"
            }
          }
        },
        {
          "name": "Actualizar Programa",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/programs/{{program_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Administración y Manejo del Sistema de Áreas Protegidas (v2)\",\n  \"code\": \"3201\",\n  \"weight\": 30.00,\n  \"description\": \"Actualizado\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "06 — Proyectos",
      "item": [
        {
          "name": "Listar Proyectos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/structure/projects?programId=&vigencia=&mine=false",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "structure", "projects"],
              "query": [
                { "key": "programId", "value": "", "description": "UUID del programa" },
                { "key": "vigencia", "value": "", "description": "Año fiscal (ej: 2026)" },
                { "key": "mine", "value": "false", "description": "true = solo mis proyectos (coordinador)" }
              ]
            }
          }
        },
        {
          "name": "Crear Proyecto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Implementación de acciones de preservación en áreas protegidas\",\n  \"programId\": \"{{program_id}}\",\n  \"vigencia\": 2026,\n  \"code\": \"320109001\",\n  \"subdivision\": \"Subdirección de Gestión Ambiental\",\n  \"weight\": 15.00\n}"
            }
          }
        },
        {
          "name": "Actualizar Proyecto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/projects/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Implementación de acciones de preservación (actualizado)\",\n  \"vigencia\": 2026,\n  \"code\": \"320109001\",\n  \"subdivision\": \"Subdirección de Gestión Ambiental\",\n  \"weight\": 20.00\n}"
            }
          }
        },
        {
          "name": "Asignar Coordinador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/projects/{{project_id}}/coordinators",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{coordinator_user_id}}\"\n}"
            }
          }
        },
        {
          "name": "Remover Coordinador",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/structure/projects/{{project_id}}/coordinators/{{coordinator_user_id}}"
          }
        }
      ]
    },
    {
      "name": "07 — Actividades",
      "item": [
        {
          "name": "Listar Actividades",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/structure/activities?projectId=",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "structure", "activities"],
              "query": [
                { "key": "projectId", "value": "", "description": "UUID del proyecto" }
              ]
            }
          }
        },
        {
          "name": "Crear Actividad",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/activities",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monitoreo de ecosistemas estratégicos\",\n  \"projectId\": \"{{project_id}}\",\n  \"sdgIndicatorIds\": [6, 13, 15],\n  \"code\": \"320109001-01\",\n  \"measurementUnit\": \"Hectáreas monitoreadas\",\n  \"goal\": 5000.00,\n  \"weight\": 40.00\n}"
            }
          }
        },
        {
          "name": "Actualizar Actividad",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/structure/activities/{{activity_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monitoreo de ecosistemas estratégicos (actualizada)\",\n  \"sdgIndicatorIds\": [6, 13, 14, 15],\n  \"code\": \"320109001-01\",\n  \"measurementUnit\": \"Hectáreas monitoreadas\",\n  \"goal\": 6000.00,\n  \"weight\": 45.00\n}"
            }
          }
        }
      ]
    },
    {
      "name": "08 — Tareas",
      "item": [
        {
          "name": "Listar Tareas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/tasks?projectId=&activityId=&status=&responsible=&from=&to=",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                { "key": "projectId", "value": "" },
                { "key": "activityId", "value": "" },
                { "key": "status", "value": "", "description": "PROGRAMADA|EN_EJECUCION|RETRASADA|COMPLETADA|NO_APLICA|CANCELADA" },
                { "key": "responsible", "value": "" },
                { "key": "from", "value": "", "description": "yyyy-MM-dd" },
                { "key": "to", "value": "", "description": "yyyy-MM-dd" }
              ]
            }
          }
        },
        {
          "name": "Crear Tarea",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activityId\": \"{{activity_id}}\",\n  \"name\": \"Realizar recorrido de campo en zona de amortiguación PNN Paramillo\",\n  \"physicalGoalValue\": 500.00,\n  \"physicalGoalUnit\": \"Hectáreas\",\n  \"dueDate\": \"2027-03-31\",\n  \"responsibleName\": \"Persona de Ejemplo\",\n  \"responsibleUserId\": \"{{coordinator_user_id}}\",\n  \"taskType\": \"Monitoreo\",\n  \"weight\": 20.00,\n  \"observation\": \"Incluir muestreo de agua en puntos clave\",\n  \"startDate\": \"2027-01-15\"\n}"
            }
          }
        },
        {
          "name": "Reprogramar Tarea",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/tasks/{{task_id}}/reschedule",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newDueDate\": \"2027-06-30\",\n  \"justification\": \"Se requiere extensión del plazo por condiciones climáticas adversas en la zona de Urabá durante el primer trimestre\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "09 — Estructura (Árbol PAC)",
      "item": [
        {
          "name": "Consultar Árbol Completo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/structure/tree?vigencia=",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "structure", "tree"],
              "query": [
                { "key": "vigencia", "value": "", "description": "Filtrar proyectos por año (ej: 2026)" }
              ]
            }
          }
        }
      ]
    }
  ]
}
